<div class="summary-header">
  <img class="profile" src="{{ img }}" data-edit="img" />

  <div class="flexcol basic-info">
    <div class="flexrow name-xp">
      <h1 class="char-name">
        <input type="text" name="name" value="{{ name }}" />
      </h1>
    </div>
  </div>
</div>

<section class="subdetails-body">
  <div class="flexrow inputs">
    <div class="info-box" data-tooltip-extended="moraleScore">
      <h5>{{localize "PF1FS.MoraleScore" }}</h5>
      <span class="value text-box direct" name="system.moraleScore" data-dtype="Number">{{ system.moraleScore }}</span>
    </div>
    <div class="info-box" data-tooltip-extended="lossCount">
      <h5>{{localize "PF1FS.LossCount" }}</h5>
      <span class="value text-box direct" name="system.lossCount" data-dtype="Number">{{ system.lossCount }}</span>
    </div>
    <div class="info-box" data-tooltip-extended="hits">
      <h5>{{localize "PF1FS.TotalHits" }}</h5>
      <span class="value">{{ system.totalHits.current }} / {{ system.totalHits.max }}</span>
    </div>
  </div>

  {{!-- Commodore --}}
  <div class="flexcol">
    <h3>{{localize "PF1FS.Commodore"}}</h3>

    <select name="system.commodore.actor">
      {{selectOptions @root.actorOptions selected=system.commodore.actorId}}
    </select>

    <div class="info-box-joined">
      <div class="info-box" data-tooltip-extended="chaMod">
        <h5>{{ localize "PF1.AbilityChaMod" }}</h5>
        <span class="value">{{ system.commodore.chaMod }}</span>
      </div>
      <div class="info-box" data-tooltip-extended="profSailor">
        <h5>{{localize "PF1FS.ProfSailor" }}</h5>
        <span class="value">{{ system.commodore.profSailor }}</span>
      </div>
      <div class="info-box">
        <h5>{{localize "PF1FS.IsSignificant" }}</h5>
        <div class="value">
          <input type="checkbox" name="system.commodore.isSignificant" {{checked system.commodore.isSignificant}} />
        </div>
      </div>
      <div class="info-box">
        <h5>{{localize "PF1FS.IsMercenary" }}</h5>
        <div class="value">
          <input type="checkbox" name="system.isMercenary" {{checked system.isMercenary}} />
        </div>
      </div>
    </div>
  </div>

  {{!-- Combat Modifiers --}}
  <div class="attributes flex0">
    <div class="info-box-header">
      <h3>{{localize "PF1.Combat"}}</h3>
      <div class="info-box-joined">
        <div class="info-box" data-tooltip-extended="dv">
          <h5>{{localize "PF1FS.DV" }}</h5>
          <span class="value">{{ system.combat.dv.total }}</span>
        </div>
        <div class="info-box" data-tooltip-extended="av">
          <h5 class="attribute" data-attribute="av">
            <a class="rollable"></a>
            <span>{{ localize "PF1FS.AV" }}</span>
          </h5>
          <span class="value">{{ numberFormat system.combat.av.total sign=true }}</span>
        </div>
        <div class="info-box" data-tooltip-extended="damageBonus">
          <h5>{{ localize "PF1.DamageBonus" }}</h5>
          <span class="value">{{ numberFormat system.combat.damageBonus.total sign=true }}</span>
        </div>
        <div class="info-box" data-tooltip-extended="morale">
          <h5 class="attribute" data-attribute="morale">
            <a class="rollable"></a>
            <span>{{ localize "PF1FS.MoraleCheck" }}</span>
          </h5>
          <span class="value">{{ numberFormat system.combat.morale.total sign=true }}</span>
        </div>
      </div>
    </div>
  </div>

  {{!-- Ships List --}}
  <ol class="item-groups-list">
    <ol class="item-list">
      <li class="item-list-header flexrow">
        <div class="item-detail item-ship-name">
          <label>{{localize "PF1FS.Ships"}}</label>
        </div>
        <div class="item-detail item-hits">
          <label>{{localize "PF1FS.Hits"}}</label>
        </div>
        <div class="item-detail item-disbled">
          <label>{{localize "PF1.Disabled"}}</label>
        </div>
        <div class="item-controls one-button">
          {{#if @root.owner}}
          <a class="ship-create" data-tooltip="PF1FS.AddShip">
            <i class="fa-solid fa-plus"></i>
          </a>
          {{/if}}
        </div>
      </li>

      {{#each system.ships as |ship idx|}}
      <li class="flexrow item ship" data-id="{{ ship.id }}">
        <div class="item-detail item-ship-name">
          <span
            class="value text-box direct{{#if ship.disabled}} disabled{{/if}}"
            name="system.ships.{{ idx }}.name"
            data-dtype="String"
            >{{ ship.name }}</span
          >
        </div>
        <div class="item-detail item-hits flexrow">
          <span class="value text-box direct" name="system.ships.{{ idx }}.currentHits" data-dtype="Number">{{
            ship.currentHits
          }}</span>
          <span class="flex0">/</span>
          <span>{{ @root.system.config.maxShipHits }}</span>
        </div>
        <div class="item-detail item-disabled">
          {{#if ship.disabled}}
          <i class="fas fa-check"></i>
          {{else}}
          <i class="fas fa-times"></i>
          {{/if}}
        </div>
        <div class="item-controls one-button">
          <a class="ship-delete" data-tooltip="PF1FS.DeleteShip">
            <i class="fa-solid fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
  </ol>
</section>

<hr />

<footer data-tooltip-extended="ships" data-tooltip-direction="UP">
  <div class="list-counts">
    <div class="info-box-joined stats ships">
      <div class="info-box">
        <h5>{{localize "PF1FS.ShipType" }}</h5>
        <select name="system.config.shipType">
          {{selectOptions shipTypeOptions selected=system.config.shipType}}
        </select>
      </div>
      <div class="info-box">
        <h5>{{ localize "PF1FS.HitsPerShip" }}</h5>
        {{#if system.config.editShipHits}}
        <span class="value text-box direct" name="system.config.maxShipHits" data-dtype="Number">{{
          system.config.maxShipHits
        }}</span>
        {{else}}
        <span class="value">{{ system.config.maxShipHits }}</span>
        {{/if}}
      </div>
      <div class="info-box">
        <h5>{{ localize "PF1FS.CurrentShips" }}</h5>
        <span class="value">{{ shipCount.current }}</span>
      </div>
      <div class="info-box">
        <h5>{{ localize "PF1FS.MaxShips" }}</h5>
        <span class="value">{{ shipCount.max }}</span>
      </div>
    </div>

    {{#if shipCount.issues}}
    <div class="info-box-joined issues" style="--issues:{{ shipCount.issues }};">
      {{#if shipCount.missing}}
      <div class="info-box missing">
        <h5>{{localize "PF1.Missing"}}</h5>
        <span class="value">{{ shipCount.missing }}</span>
      </div>
      {{else if shipCount.excess}}
      <div class="info-box excess">
        <h5>{{localize "PF1.Excess"}}</h5>
        <span class="value">{{ shipCount.excess }}</span>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>
</footer>
