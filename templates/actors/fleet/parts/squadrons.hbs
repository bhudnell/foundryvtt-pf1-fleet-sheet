<ol class="item-groups-list">
  <ol class="item-list">
    <li class="flexrow item-list-header">
      <div class="item-name">
        <h3>{{ localize "PF1FS.Squadrons" }}</h3>
      </div>
      <div class="item-detail item-hits">
        <label>{{localize "PF1FS.TotalHits"}}</label>
      </div>
      <div class="item-detail item-number" data-tooltip="PF1FS.MoraleScore"><i class="ra ra-beer"></i></div>
      <div class="item-detail item-ship-type">
        <label>{{localize "PF1FS.ShipType"}}</label>
      </div>
      <div class="item-detail item-number" data-tooltip="PF1FS.IsMercenary"><i class="ra ra-dervish-swords"></i></div>

      <div class="item-detail item-actor">
        <label>{{localize "PF1FS.Commodore"}}</label>
      </div>

      <div class="item-detail item-number" data-tooltip="PF1FS.AV"><i class="ra ra-sword"></i></div>
      <div class="item-detail item-number" data-tooltip="PF1FS.DV"><i class="ra ra-shield"></i></div>
      <div class="item-detail item-number" data-tooltip="PF1FS.MoraleCheck"><i class="ra ra-horn-call"></i></div>

      <div class="item-detail item-controls two-button">
        <a class="item-control squadron-create" data-tooltip="PF1FS.CreateSquadron">
          <i class="fa-solid fa-plus"></i>
        </a>
      </div>
    </li>
    {{#each squadrons}}
    <li class="flexrow item" data-id="{{ id }}">
      <div class="item-name expand-summary no-events">
        <div class="item-image" style="background-image: url('{{ img }}')"></div>
        <span>{{ name }}</span>
      </div>
      <span class="item-detail item-hits">{{ system.totalHits.current }} / {{ system.totalHits.max }}</span>
      <span class="item-detail item-number">{{ system.moraleScore }}</span>
      <span class="item-detail item-ship-type">{{ system.shipType }}</span>
      <span class="item-detail item-number">
        {{#if system.isMercenary}}
        <i class="fas fa-check"></i>
        {{else}}
        <i class="fas fa-times"></i>
        {{/if}}
      </span>

      <span class="item-detail item-actor">{{ system.commodore.name }}</span>

      <span class="item-detail item-number">{{ system.combat.av.total }}</span>
      <span class="item-detail item-number">{{ system.combat.dv.total }}</span>
      <span class="item-detail item-number">{{ system.combat.morale.total }}</span>

      <div class="flexrow item-detail item-controls two-button">
        <a class="item-control squadron-edit" data-tooltip="PF1FS.EditSquadron">
          <i class="fa-solid fa-pen-to-square"></i>
        </a>
        <a class="item-control squadron-delete" data-tooltip="PF1FS.DeleteSquadron">
          <i class="fa-solid fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>
</ol>

<hr />

<footer data-tooltip-extended="squadrons" data-tooltip-direction="UP">
  <div class="list-counts">
    <div class="info-box-joined stats squadrons">
      <div class="info-box">
        <h5>{{ localize "PF1.Current" }}</h5>
        <span class="value">{{ squadronCount.current }}</span>
      </div>
      <div class="info-box">
        {{#if showInfamy}}
        <h5>{{localize "PF1FS.Infamy" }}</h5>
        {{else}}
        <h5>{{localize "PF1.Base" }}</h5>
        {{/if}}
        <span class="value">{{ squadronCount.base }}</span>
      </div>
      <div class="info-box">
        <h5>{{localize "PF1FS.Admiral" }}</h5>
        <span class="value">{{ squadronCount.admiral }}</span>
      </div>
      <div class="info-box">
        <h5>{{localize "PF1.Bonus" }}</h5>
        <span class="value">{{ squadronCount.bonus }}</span>
      </div>
      <div class="info-box">
        <h5>{{ localize "PF1.MaxShort" }}</h5>
        <span class="value">{{ squadronCount.max }}</span>
      </div>
    </div>

    {{#if squadronCount.issues}}
    <div class="info-box-joined issues" style="--issues:{{ squadronCount.issues }};">
      {{#if squadronCount.missing}}
      <div class="info-box missing">
        <h5>{{localize "PF1.Missing"}}</h5>
        <span class="value">{{ squadronCount.missing }}</span>
      </div>
      {{else if squadronCount.excess}}
      <div class="info-box excess">
        <h5>{{localize "PF1.Excess"}}</h5>
        <span class="value">{{ squadronCount.excess }}</span>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>
</footer>
